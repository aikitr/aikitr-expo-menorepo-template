{
  "name": "@repo/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios",
    "dev": "expo start --dev-client",
    "eas-build-post-install": "pnpm --dir ../.. build:packages",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "native:prebuild": "expo prebuild --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "catalog:mobile",
    "@repo/api": "workspace:*",
    "@repo/core": "workspace:*",
    "@repo/tokens": "workspace:*",
    "expo": "catalog:mobile",
    "expo-blur": "catalog:mobile",
    "expo-build-properties": "catalog:mobile",
    "expo-constants": "catalog:mobile",
    "expo-dev-client": "catalog:mobile",
    "expo-linking": "catalog:mobile",
    "expo-router": "catalog:mobile",
    "expo-status-bar": "catalog:mobile",
    "heroui-native": "catalog:mobile",
    "react": "catalog:mobile",
    "react-dom": "catalog:mobile",
    "react-native": "catalog:mobile",
    "react-native-gesture-handler": "catalog:mobile",
    "react-native-reanimated": "catalog:mobile",
    "react-native-safe-area-context": "catalog:mobile",
    "react-native-screens": "catalog:mobile",
    "react-native-svg": "catalog:mobile",
    "react-native-worklets": "catalog:mobile",
    "tailwind-merge": "catalog:mobile",
    "tailwind-variants": "catalog:mobile",
    "tailwindcss": "catalog:mobile",
    "uniwind": "catalog:mobile"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/react": "catalog:mobile",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
