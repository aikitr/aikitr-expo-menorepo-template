{
  "name": "aikitr-expo-monorepo-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": ">=12 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.7.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@repo/mobile",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:weapp": "turbo run build --filter=@repo/weapp",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:mobile": "turbo run dev --filter=@repo/mobile --filter='./packages/*'",
    "dev:weapp": "turbo run dev --filter=@repo/weapp --filter='./packages/*'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
