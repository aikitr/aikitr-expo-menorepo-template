{
  "name": "aikitr-expo-monorepo-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.23.3 <23",
    "pnpm": ">=10 <11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.34.6",
      "onFail": "warn"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=@repo/mobile",
    "build:packages": "turbo run build --filter='./packages/*'",
    "build:weapp": "turbo run build --filter=@repo/weapp",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev:mobile": "turbo run dev --filter=@repo/mobile --filter='./packages/*'",
    "dev:weapp": "turbo run dev --filter=@repo/weapp --filter='./packages/*'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.0.16"
  }
}
